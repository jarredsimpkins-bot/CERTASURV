{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://certasurv.local/schemas/certa-task.schema.json",
  "title": "CertaSurv Routed Task",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "created_at",
    "request",
    "status",
    "allowed_lanes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 8},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string"},
    "computer": {"type": "string"},
    "project_id": {"type": ["string", "null"]},
    "request": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "preferred_lane": {
      "type": ["string", "null"],
      "enum": [null, "SCRIPT", "OLLAMA", "CODEX", "SPECIALIST", "HUMAN"]
    },
    "allowed_lanes": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["SCRIPT", "OLLAMA", "CODEX", "SPECIALIST", "HUMAN"]}
    },
    "sensitivity": {
      "enum": ["NORMAL", "COMPANY", "CLIENT", "RESTRICTED"]
    },
    "status": {
      "enum": ["NEW", "ROUTED", "CANDIDATE_COMPLETE", "VALIDATED", "FAILED", "REVIEW_REQUIRED"]
    },
    "route": {"type": ["object", "null"]},
    "history": {"type": "array"}
  },
  "additionalProperties": true
}
